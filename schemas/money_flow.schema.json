{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Money-flow file (Sankey view source data)",
  "type": "object",
  "required": ["schema_version", "investigation_slug", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "investigation_slug": {"type": "string", "minLength": 1},
    "generated_at": {"type": ["string", "null"], "format": "date"},
    "generated_by": {"type": ["string", "null"]},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "node_type"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "node_type": {
            "enum": ["committee", "pac", "vendor", "foundation", "category", "person", "org"]
          },
          "investigation_node_id": {"type": ["string", "null"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "source_id", "target_id", "amount_usd", "flow_type",
          "confidence", "source_url", "source_title", "accessed_date"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "target_id": {"type": "string", "minLength": 1},
          "amount_usd": {"type": "number", "minimum": 0},
          "flow_type": {
            "enum": ["contribution", "disbursement", "refund", "grant", "transfer", "conduit_contribution"]
          },
          "period_start": {"type": ["string", "null"], "format": "date"},
          "period_end": {"type": ["string", "null"], "format": "date"},
          "transaction_count": {"type": ["integer", "null"], "minimum": 0},
          "confidence": {"enum": ["A", "B", "C", "D"]},
          "source_url": {"type": "string", "minLength": 1},
          "source_title": {"type": "string", "minLength": 1},
          "accessed_date": {"type": "string", "format": "date"},
          "note": {"type": ["string", "null"]}
        }
      }
    }
  }
}
